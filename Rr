        </div>
    </div>

    <!-- Love Letter Modal -->
    <div id="letterModal" class="fixed inset-0 z-30 flex items-center justify-center p-4 bg-black/70 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300">
        <div class="glass-card w-full max-w-lg p-6 md:p-8 rounded-3xl relative transform scale-90 transition-all duration-300 border border-rose-400/30 max-h-[85vh] flex flex-col">
            <!-- Close Button -->
            <button id="closeLetter" class="absolute top-4 right-4 text-rose-300 hover:text-white p-2">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>

            <div class="text-center mb-4">
                <i class="fa-solid fa-envelope-open-heart text-4xl text-rose-400 mb-2"></i>
                <h3 class="font-calligraphy text-3xl text-rose-200">寫給你的情書</h3>
            </div>

            <!-- Envelope Letter Content Body -->
            <div class="overflow-y-auto pr-2 space-y-4 text-rose-100/90 leading-relaxed font-light text-sm md:text-base border-t border-b border-rose-500/20 py-4 my-2">
                <p class="font-semibold text-rose-300 text-lg">
                    親愛的 <span id="letterRecipient">最愛的你</span>：
