                <svg class="w-28 h-28 md:w-40 md:h-40 text-rose-500 fill-current drop-shadow-2xl" viewBox="0 0 24 24">
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                </svg>
                <div class="absolute inset-0 flex items-center justify-center text-white font-semibold text-sm md:text-base tracking-widest pointer-events-none drop-shadow">
                    <span class="bg-black/20 backdrop-blur-sm px-3 py-1 rounded-full border border-white/20 group-hover:bg-rose-600/40 transition">點擊愛心</span>
                </div>
