<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>我愛你 - 專屬浪漫心動時刻</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Ma+Shan+Zheng&family=Noto+Serif+TC:wght@400;600;900&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* Custom Fonts */
        .font-calligraphy {
            font-family: 'Ma Shan Zheng', 'Noto Serif TC', serif;
        }
        .font-romantic {
            font-family: 'Dancing Script', cursive;
        }
        .font-main {
            font-family: 'Poppins', 'Noto Serif TC', sans-serif;
        }

        /* Dynamic Animated Background Gradient */
        body {
            background: linear-gradient(135deg, #0d0614 0%, #2a081d 35%, #4a0e2e 70%, #150518 100%);
            background-size: 400% 400%;
            animation: gradientBG 18s ease infinite;
            overflow: hidden;
            user-select: none;
            -webkit-user-select: none;
        }

        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Text Shimmer Effect for Main "我愛你" Calligraphy */
        .shimmer-text {
            background: linear-gradient(90deg, #ff758c 0%, #ff7eb3 25%, #ffffff 50%, #ff7eb3 75%, #ff758c 100%);
            background-size: 200% auto;
            color: transparent;
            -webkit-background-clip: text;
            background-clip: text;
            animation: shine 4s linear infinite;
            filter: drop-shadow(0 0 25px rgba(255, 117, 140, 0.8));
        }

        @keyframes shine {
            to { background-position: 200% center; }
        }

        /* Heart Glow & Pulse Animation */
        .heart-glow {
            filter: drop-shadow(0 0 20px rgba(255, 60, 110, 0.9)) drop-shadow(0 0 45px rgba(255, 105, 180, 0.6));
        }

        .pulse-heart {
            animation: pulseAnimation 1.6s ease-in-out infinite;
        }

        @keyframes pulseAnimation {
            0% { transform: scale(1); }
            14% { transform: scale(1.15); }
            28% { transform: scale(1.05); }
            42% { transform: scale(1.22); }
            70% { transform: scale(1); }
        }

        /* Glassmorphism Styling */
        .glass-card {
            background: rgba(255, 255, 255, 0.07);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.1);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(255, 105, 180, 0.4);
            border-radius: 3px;
        }

        /* Subtle Ripple Animation */
        .ripple {
            position: absolute;
            border-radius: 50%;
            transform: scale(0);
            animation: rippleEffect 0.8s ease-out;
            background: radial-gradient(circle, rgba(255,182,193,0.8) 0%, rgba(255,105,180,0.2) 60%, transparent 100%);
            pointer-events: none;
        }

        @keyframes rippleEffect {
            to {
                transform: scale(4);
                opacity: 0;
            }
        }
    </style>
</head>
<body class="font-main text-white h-screen w-screen overflow-hidden relative">

    <!-- Interactive Physics Canvas Background -->
    <canvas id="loveCanvas" class="fixed inset-0 z-0 w-full h-full cursor-pointer"></canvas>

    <!-- Top Floating Navbar Controls -->
    <header class="fixed top-4 left-0 right-0 z-20 px-4 md:px-8 flex justify-between items-center pointer-events-none">
        <!-- Title Badge -->
        <div class="glass-card px-4 py-2 rounded-full flex items-center space-x-2 pointer-events-auto transition hover:scale-105">
            <span class="w-3 h-3 rounded-full bg-rose-500 animate-ping"></span>
            <span class="text-xs md:text-sm font-semibold tracking-wider text-rose-200">浪漫告白時刻</span>
        </div>

        <!-- Toolbar Buttons -->
        <div class="flex items-center space-x-2 md:space-x-3 pointer-events-auto">
            <!-- Customization Button -->
            <button id="btnSettings" class="glass-card p-3 rounded-full text-rose-200 hover:text-white hover:bg-rose-500/30 transition transform hover:rotate-12 active:scale-95" title="個性化設定">
                <i class="fa-solid fa-pen-sparkles text-lg"></i>
            </button>

            <!-- Love Letter Modal Button -->
            <button id="btnLetter" class="glass-card p-3 rounded-full text-rose-200 hover:text-white hover:bg-rose-500/30 transition transform hover:scale-110 active:scale-95 relative" title="情書與告白">
                <i class="fa-solid fa-envelope-open-text text-lg"></i>
