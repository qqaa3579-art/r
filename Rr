            </button>

            <h3 class="font-calligraphy text-3xl text-rose-200 mb-6 text-center border-b border-rose-500/20 pb-2">
                <i class="fa-solid fa-heart-circle-bolt mr-2 text-rose-400"></i>訂製專屬浪漫
            </h3>

            <div class="space-y-5">
                <!-- Recipient Input -->
                <div>
                    <label class="block text-xs font-semibold text-rose-200 uppercase tracking-wider mb-2">對象名稱 (To Name)</label>
                    <input type="text" id="inputRecipient" placeholder="例如：小美 / 最愛的親愛的" 
