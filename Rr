            <button id="btnLetterInteractive" class="w-full py-3 rounded-xl bg-rose-500/80 hover:bg-rose-500 text-white font-medium transition text-sm flex items-center justify-center space-x-2">
                <i class="fa-solid fa-heart"></i>
                <span>收到滿滿愛意 (觸發愛心雨)</span>
            </button>
        </div>
    </div>

    <!-- JavaScript Logic -->
    <script>
        // --- Web Audio API Synthesizer (Zero External Dependencies) ---
        class RomanticAudio {
            constructor() {
                this.ctx = null;
                this.muted = false;
                this.isInitialized = false;
            }

            init() {
                if (!this.isInitialized) {
                    const AudioContext = window.AudioContext || window.webkitAudioContext;
                    this.ctx = new AudioContext();
                    this.isInitialized = true;
                }
                if (this.ctx && this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }
            }

            // Play delicate harp/chime note on click
            playChime(freq = 523.25, type = 'sine', duration = 1.2) {
                if (this.muted || !this.isInitialized) return;

                try {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();

                    osc.type = type;
                    osc.frequency.setValueAtTime(freq, this.ctx.currentTime);

                    // Soft attack & gradual decay
                    gain.gain.setValueAtTime(0.001, this.ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.25, this.ctx.currentTime + 0.05);
                    gain.gain.exponentialRampToValueAtTime(0.0001, this.ctx.currentTime + duration);

                    osc.connect(gain);
                    gain.connect(this.ctx.destination);

                    osc.start();
                    osc.stop(this.ctx.currentTime + duration);
                } catch (e) {
                    console.log('Audio playback prevented');
                }
            }

            // Play rich pentatonic chime chord burst
            playChordBurst() {
                if (this.muted) return;
                this.init();
                // Pentatonic chord scale (C5, D5, E5, G5, A5, C6, E6)
                const freqs = [523.25, 587.33, 659.25, 783.99, 880.00, 1046.50, 1318.51];
                freqs.forEach((f, i) => {
                    setTimeout(() => {
                        this.playChime(f, 'sine', 1.8);
                    }, i * 65);
                });
            }
        }

        const audioSys = new RomanticAudio();

        // --- Canvas Particle & Physics Engine ---
        const canvas = document.getElementById('loveCanvas');
        const ctx = canvas.getContext('2d');

        let width = canvas.width = window.innerWidth;
        let height = canvas.height = window.innerHeight;

        window.addEventListener('resize', () => {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
        });

        // Romantic Phrases for Dynamic Floating Popups
        const romanticPhrases = [
            "我愛你", "遇見你真好", "永遠愛你", "心動時刻", 
            "你是最棒的", "Je t'aime", "Aishiteru", "Love You", 
            "甜蜜相伴", "唯你獨尊", "余生皆是你", "心花怒放",
            "歲月靜好", "愛你麼麼噠", "Saranghae", "Te Amo"
        ];

        // Multi-language Subtle Ambient Background Wall
        const bgLanguages = [
            "I Love You", "我愛你", "Je t'aime", "愛してる", "Saranghae", 
            "Te amo", "Ich liebe dich", "Ti amo", "Я тебя люблю", "Obicham te"
        ];

        const particles = [];
        const floatingTexts = [];
        const bgStars = [];

        // Initialize Ambient Stars Background
        for (let i = 0; i < 80; i++) {
            bgStars.push({
                x: Math.random() * width,
                y: Math.random() * height,
                size: Math.random() * 2 + 0.5,
                alpha: Math.random() * 0.8 + 0.2,
                speed: Math.random() * 0.02 + 0.005
            });
        }

        // Particle Class (Hearts & Sparkles)
        class Particle {
            constructor(x, y, isHeart = true, customColor = null) {
                this.x = x;
                this.y = y;
                this.isHeart = isHeart;
                this.size = isHeart ? Math.random() * 16 + 10 : Math.random() * 5 + 2;
                this.vx = (Math.random() - 0.5) * (isHeart ? 6 : 10);
                this.vy = (Math.random() - 0.5) * (isHeart ? 6 : 10) - (isHeart ? 2 : 0);
                this.gravity = isHeart ? -0.04 : 0.05; // Hearts float upwards gently
                this.alpha = 1;
                this.decay = Math.random() * 0.015 + 0.008;
                this.rotation = Math.random() * Math.PI * 2;
                this.rotSpeed = (Math.random() - 0.5) * 0.08;
                
                // Color palette
                const colors = ['#ff2a75', '#ff5388', '#ff758c', '#ff8fa3', '#ffffff', '#ffd1dc'];
                this.color = customColor || colors[Math.floor(Math.random() * colors.length)];
            }

            update() {
                this.x += this.vx;
                this.y += this.vy;
                this.vy += this.gravity;
                this.vx *= 0.98;
                this.rotation += this.rotSpeed;
                this.alpha -= this.decay;
            }

            draw(ctx) {
                ctx.save();
                ctx.globalAlpha = Math.max(this.alpha, 0);
                ctx.translate(this.x, this.y);
                ctx.rotate(this.rotation);

                if (this.isHeart) {
                    // Draw Vector Heart
                    ctx.beginPath();
                    ctx.fillStyle = this.color;
                    const s = this.size;
                    ctx.moveTo(0, s * 0.3);
                    ctx.bezierCurveTo(0, 0, -s / 2, 0, -s / 2, s * 0.3);
                    ctx.bezierCurveTo(-s / 2, (s + s * 0.3) / 2, 0, s, 0, s * 1.2);
                    ctx.bezierCurveTo(0, s, s / 2, (s + s * 0.3) / 2, s / 2, s * 0.3);
                    ctx.bezierCurveTo(s / 2, 0, 0, 0, 0, s * 0.3);
                    ctx.closePath();
                    ctx.shadowColor = this.color;
                    ctx.shadowBlur = 10;
                    ctx.fill();
                } else {
                    // Draw Sparkle / Star
                    ctx.fillStyle = this.color;
                    ctx.beginPath();
                    ctx.arc(0, 0, this.size, 0, Math.PI * 2);
                    ctx.fill();
                }

                ctx.restore();
            }
        }

        // Floating Romantic Text Class
        class FloatingText {
            constructor(x, y, text) {
                this.x = x;
                this.y = y;
                this.text = text;
                this.alpha = 1;
                this.vy = -1.5 - Math.random();
                this.vx = (Math.random() - 0.5) * 1.5;
                this.decay = 0.012;
                this.scale = 0.8 + Math.random() * 0.5;
            }

            update() {
                this.x += this.vx;
                this.y += this.vy;
                this.alpha -= this.decay;
                this.scale += 0.003;
            }

            draw(ctx) {
                ctx.save();
                ctx.globalAlpha = Math.max(this.alpha, 0);
                ctx.font = `bold ${Math.round(20 * this.scale)}px "Ma Shan Zheng", "Noto Serif TC", serif`;
                ctx.fillStyle = '#ffffff';
                ctx.shadowColor = '#ff3366';
                ctx.shadowBlur = 12;
                ctx.textAlign = 'center';
                ctx.fillText(this.text, this.x, this.y);
                ctx.restore();
            }
        }

        // Spawn Burst of Hearts and Text on Event
        function spawnLoveBurst(x, y, count = 25, customText = null) {
            audioSys.init();
            audioSys.playChordBurst();

            // Spawn Heart Particles
            for (let i = 0; i < count; i++) {
                particles.push(new Particle(x, y, true));
            }
            // Spawn Sparkles
            for (let i = 0; i < 12; i++) {
                particles.push(new Particle(x, y, false));
            }

            // Spawn Dynamic Floating Text
            const phrase = customText || romanticPhrases[Math.floor(Math.random() * romanticPhrases.length)];
            floatingTexts.push(new FloatingText(x, y - 20, phrase));

            // Visual Ripple
            createRipple(x, y);
        }

        // Create DOM Ripple Effect
        function createRipple(x, y) {
            const ripple = document.createElement('div');
            ripple.className = 'ripple';
            ripple.style.left = `${x - 50}px`;
            ripple.style.top = `${y - 50}px`;
            ripple.style.width = '100px';
            ripple.style.height = '100px';
            document.body.appendChild(ripple);
            setTimeout(() => ripple.remove(), 800);
        }

        // Canvas Main Animation Loop
        function animate() {
            ctx.clearRect(0, 0, width, height);

            // 1. Draw Ambient Starfield Background
            bgStars.forEach(star => {
                star.alpha += Math.sin(Date.now() * star.speed) * 0.01;
                ctx.fillStyle = `rgba(255, 255, 255, ${Math.abs(star.alpha)})`;
                ctx.beginPath();
                ctx.arc(star.x, star.y, star.size, 0, Math.PI * 2);
                ctx.fill();
            });

            // 2. Draw Multi-Language Subtle Ambient Wall
            ctx.save();
            ctx.font = '16px "Dancing Script", cursive';
            ctx.fillStyle = 'rgba(255, 182, 193, 0.06)';
            for (let i = 0; i < bgLanguages.length; i++) {
                const lx = (i * 180 + Date.now() * 0.01) % (width + 200) - 100;
                const ly = 80 + (i * 65) % (height - 100);
                ctx.fillText(bgLanguages[i], lx, ly);
            }
            ctx.restore();

            // 3. Update & Draw Particles
            for (let i = particles.length - 1; i >= 0; i--) {
                const p = particles[i];
                p.update();
                p.draw(ctx);
                if (p.alpha <= 0) particles.splice(i, 1);
            }

            // 4. Update & Draw Floating Texts
            for (let i = floatingTexts.length - 1; i >= 0; i--) {
                const ft = floatingTexts[i];
                ft.update();
                ft.draw(ctx);
                if (ft.alpha <= 0) floatingTexts.splice(i, 1);
            }

            requestAnimationFrame(animate);
        }

        animate();

        // --- Event Listeners & Interaction ---

        // Global Canvas Click / Touch Event
        canvas.addEventListener('click', (e) => {
            spawnLoveBurst(e.clientX, e.clientY);
        });

        // Main Heart Button Click
        const mainHeart = document.getElementById('mainHeart');
        const messageContainer = document.getElementById('messageContainer');

        mainHeart.addEventListener('click', (e) => {
            e.stopPropagation();
            const rect = mainHeart.getBoundingClientRect();
            const centerX = rect.left + rect.width / 2;
            const centerY = rect.top + rect.height / 2;

            // Massive Burst Effect
            spawnLoveBurst(centerX, centerY, 60, document.getElementById('mainMessage').innerText);

            // Dynamic Heart Bump Animation
            messageContainer.classList.remove('scale-95');
            messageContainer.classList.add('scale-110');
            setTimeout(() => {
                messageContainer.classList.remove('scale-110');
                messageContainer.classList.add('scale-95');
            }, 300);
        });

        // Customization Modal Logic
        const btnSettings = document.getElementById('btnSettings');
        const settingsModal = document.getElementById('settingsModal');
        const closeSettings = document.getElementById('closeSettings');
        const saveSettings = document.getElementById('saveSettings');

        const inputRecipient = document.getElementById('inputRecipient');
        const inputMainMsg = document.getElementById('inputMainMsg');

        const displayRecipient = document.getElementById('displayRecipient');
        const recipientTag = document.getElementById('recipientTag');
        const mainMessage = document.getElementById('mainMessage');
        const letterRecipient = document.getElementById('letterRecipient');

        btnSettings.addEventListener('click', () => {
            settingsModal.classList.remove('opacity-0', 'pointer-events-none');
            settingsModal.children[0].classList.remove('scale-90');
            settingsModal.children[0].classList.add('scale-100');
        });

        function hideSettings() {
            settingsModal.classList.add('opacity-0', 'pointer-events-none');
            settingsModal.children[0].classList.remove('scale-100');
            settingsModal.children[0].classList.add('scale-90');
        }

        closeSettings.addEventListener('click', hideSettings);

        saveSettings.addEventListener('click', () => {
            const recipientVal = inputRecipient.value.trim();
            const msgVal = inputMainMsg.value.trim();

            if (recipientVal) {
                displayRecipient.innerText = recipientVal;
                letterRecipient.innerText = recipientVal;
                recipientTag.classList.remove('opacity-0', 'translate-y-4');
            }

            if (msgVal) {
                mainMessage.innerText = msgVal;
            }

            hideSettings();
            spawnLoveBurst(window.innerWidth / 2, window.innerHeight / 2, 30, "設定成功 ❤️");
        });

        // Theme Preset Switcher
        const themeBtns = document.querySelectorAll('.theme-btn');
        themeBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                themeBtns.forEach(b => b.classList.remove('ring-2', 'ring-rose-400'));
                btn.classList.add('ring-2', 'ring-rose-400');
                const theme = btn.dataset.theme;

                if (theme === 'purple') {
                    document.body.style.background = 'linear-gradient(135deg, #090314 0%, #1a0826 35%, #380e4a 70%, #0d0518 100%)';
                } else if (theme === 'pink') {
                    document.body.style.background = 'linear-gradient(135deg, #1c0512 0%, #3b0a24 35%, #5e1339 70%, #210515 100%)';
                } else {
                    document.body.style.background = 'linear-gradient(135deg, #0d0614 0%, #2a081d 35%, #4a0e2e 70%, #150518 100%)';
                }
            });
        });

        // Love Letter Modal Logic
        const btnLetter = document.getElementById('btnLetter');
        const letterModal = document.getElementById('letterModal');
        const closeLetter = document.getElementById('closeLetter');
        const btnLetterInteractive = document.getElementById('btnLetterInteractive');

        btnLetter.addEventListener('click', () => {
            letterModal.classList.remove('opacity-0', 'pointer-events-none');
            letterModal.children[0].classList.remove('scale-90');
            letterModal.children[0].classList.add('scale-100');
        });

        function hideLetter() {
            letterModal.classList.add('opacity-0', 'pointer-events-none');
            letterModal.children[0].classList.remove('scale-100');
            letterModal.children[0].classList.add('scale-90');
        }

        closeLetter.addEventListener('click', hideLetter);

        btnLetterInteractive.addEventListener('click', () => {
            hideLetter();
            // Heart shower burst across top screen
            for (let i = 0; i < 6; i++) {
                setTimeout(() => {
                    spawnLoveBurst(
                        Math.random() * window.innerWidth, 
                        Math.random() * (window.innerHeight * 0.5), 
                        20, 
                        "愛你每一天"
                    );
                }, i * 180);
            }
        });

        // Audio Toggle Button
        const btnAudio = document.getElementById('btnAudio');
        const audioIcon = document.getElementById('audioIcon');

        btnAudio.addEventListener('click', () => {
            audioSys.muted = !audioSys.muted;
            if (audioSys.muted) {
                audioIcon.className = 'fa-solid fa-volume-xmark text-lg text-rose-400/50';
            } else {
                audioIcon.className = 'fa-solid fa-volume-high text-lg text-rose-200';
                audioSys.init();
                audioSys.playChime(659.25);
            }
        });

        // Fullscreen Toggle Button
        const btnFullscreen = document.getElementById('btnFullscreen');
        btnFullscreen.addEventListener('click', () => {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen().catch(() => {});
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                }
            }
        });

        // Auto trigger subtle background hearts periodically
        setInterval(() => {
            if (Math.random() > 0.4) {
                particles.push(new Particle(
                    Math.random() * width, 
                    height + 20, 
                    true
                ));
            }
        }, 600);
    </script>
</body>
</html>
