        <!-- Dynamic Main Love Message Display -->
        <div id="messageContainer" class="text-center mt-2 max-w-2xl transition-all duration-700 transform scale-95 opacity-90">
            <h1 id="mainMessage" class="font-calligraphy text-6xl sm:text-7xl md:text-9xl font-bold shimmer-text leading-tight my-2">
                我愛你
            </h1>
            <p id="subMessage" class="font-romantic text-xl sm:text-2xl md:text-3xl text-rose-200/90 tracking-widest mt-1 drop-shadow">
                I Love You • Je t'aime • 愛してる
